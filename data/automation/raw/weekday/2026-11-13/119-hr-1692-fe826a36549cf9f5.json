      "actionCode": "H30000",
      "actionDate": "2025-03-10",
      "actionTime": "16:52:34",
      "sourceSystem": {
        "code": 2,
        "name": "House floor actions"
      },
      "text": "Considered under suspension of the rules. (consideration: CR H1055-1056)",
      "type": "Floor"
    },
